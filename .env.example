# =================================================================
# Relay 0.2 Configuration (.env.example)
# =================================================================

# Database
# For PostgreSQL: postgresql+asyncpg://relay_user:relay_password@localhost:5432/relay_db
# For SQLite (local-dev fallback): sqlite+aiosqlite:///./relay.db
DATABASE_URL=sqlite+aiosqlite:///./relay.db

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production_32b
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256 / Fernet key for encrypting credentials at rest
# Generate in python with: cryptography.fernet.Fernet.generate_key().decode()
ENCRYPTION_KEY=W03_3n9D3vE10pm3ntK3yF0rR31ay02App11cat1onS3cur1ty=

# LLM Provider Configuration
# Options: ollama, gemini, openai, anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Hosted LLM API Keys (optional if using Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth (for Google Calendar and Gmail tools)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/oauth/google/callback

# Slack & GitHub OAuth/Integrations
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend Configuration
VITE_API_URL=http://localhost:8000
