# =================================================================
# Relay 0.2 Environment Configuration (.env.example)
# =================================================================
# Copy this file to .env and configure values before deploying.
# Generate secrets using: python scripts/generate_secrets.py

# ── Environment & App Mode ──────────────────────────────────────
# production | development | test
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=Relay
EXECUTION_TIMEOUT_SECONDS=1800

# ── Database (PostgreSQL) ──────────────────────────────────────
# Production Managed PostgreSQL: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Note: postgres:// and postgresql:// URLs are automatically normalized to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://relay_user:relay_password@db.example.com:5432/relay_db

# ── Security & Authentication ──────────────────────────────────
# Hex-encoded 32-byte JWT secret key (must NOT be default in production)
# Generate with: python scripts/generate_secrets.py
SECRET_KEY=replace_with_generated_hex32_jwt_secret_key_in_production

# JWT token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AES-256 Fernet key for encrypting credentials and tokens at rest
# Supports comma-separated keys for zero-downtime key rotation
# Generate with: python scripts/generate_secrets.py
ENCRYPTION_KEY=replace_with_generated_fernet_base64_encryption_key_here=

# ── Frontend & CORS ───────────────────────────────────────────
# Public URL of the frontend on Vercel
FRONTEND_URL=https://relay-app.vercel.app

# Comma-separated or JSON list of allowed origins for CORS
BACKEND_CORS_ORIGINS=https://relay-app.vercel.app,http://localhost:5173,http://localhost:3000

# ── LLM Provider Configuration ────────────────────────────────
# Provider selection: ollama | gemini | openai | anthropic
LLM_PROVIDER=ollama

# Ollama Endpoint Configuration (Hosted Ollama or private GPU endpoint)
OLLAMA_BASE_URL=https://ollama.yourdomain.com
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Hosted LLM Provider API Keys (required if LLM_PROVIDER is gemini/openai/anthropic)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Google OAuth & Integrations ────────────────────────────────
# Google Cloud Console OAuth 2.0 Web Application credentials
# Scopes: Google Calendar, Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://relay-backend.onrender.com/api/v1/connections/oauth/google/callback

# Slack App Integration (Optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub OAuth Integration (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── MCP (Model Context Protocol) & Network Security ────────────
# Must remain False in production to enforce strict SSRF protection
ALLOW_PRIVATE_NETWORKS=false

# Must remain False in production (disallows loopback/local MCP endpoints)
RELAY_DEV_ALLOW_LOCAL_MCP=false
RELAY_DEV_LOCAL_MCP_HOSTS=127.0.0.1,localhost

# JSON list of trusted local stdio MCP configurations (if using stdio MCP in container)
RELAY_TRUSTED_MCP_SERVERS=[]

# ── Frontend Environment Variable (Set in Vercel) ──────────────
# Public URL of the backend on Render
VITE_API_URL=https://relay-backend.onrender.com
